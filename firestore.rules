rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ RÈGLES TEMPORAIRES - À utiliser uniquement en développement!
    // Ces règles permettent l'accès complet à Firestore.
    // À remplacer par des règles plus sécurisées en production.
    
    match /{document=**} {
      allow read, write: if true;
    }

    // Exemple de règles plus sécurisées (à activer plus tard):
    /*
    match /commandes/{document=**} {
      // Permettre la lecture et l'écriture pour les utilisateurs authentifiés
      allow read, write: if request.auth != null;
    }
    
    match /livraisons/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /utilisateurs/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    */
  }
}
